<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">

  <Id>com.klaus.headerextractor</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Klaus</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName>Header Extractor</DisplayName>
  <Description>Automatically extracts [Title: ...] and inserts centered header</Description>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://yourdomain.com/headeraddin/home.html"/>
  </DefaultSettings>

  <LaunchEvents>
    <LaunchEvent Type="OnDocumentOpened" FunctionName="applyHeaderRule"/>
    <LaunchEvent Type="OnDocumentCreated" FunctionName="applyHeaderRule"/>
  </LaunchEvents>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
